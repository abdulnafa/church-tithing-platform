# Church Digital Tithing Platform
# Copy this file to .env.local for local development.
# Never commit real credentials. NEXT_PUBLIC_* values are visible in the browser.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Vercel deployments fall back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# Set this explicitly before printing QR codes for a custom production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
PLATFORM_ROOT_DOMAIN=localhost:3000
PLATFORM_TIMEZONE=America/Barbados
PLATFORM_SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Supabase: database, authentication, and private storage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Canadian Stripe account: USD 99/month church SaaS subscription ONLY
# Never use this account or these variables to process church donations.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SAAS_PRICE_ID=

# -----------------------------------------------------------------------------
# Church donation provider
# Keep "mock" until the Barbados provider and sandbox are approved.
# These generic sandbox variables will be mapped by the future provider adapter.
# Per-church production merchant credentials must be tenant-scoped and encrypted
# or connected through provider OAuth; do not share one live merchant credential.
# -----------------------------------------------------------------------------
DONATION_PROVIDER_DRIVER=mock
DONATION_PROVIDER_API_BASE_URL=
DONATION_PROVIDER_PUBLIC_KEY=
DONATION_PROVIDER_SECRET_KEY=
DONATION_PROVIDER_WEBHOOK_SECRET=
DONATION_PROVIDER_PILOT_MERCHANT_ID=

# -----------------------------------------------------------------------------
# Transactional email
# Set EMAIL_PROVIDER to "resend" or "sendgrid" once selected.
# Only the API key for the selected provider is required.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM="Church Giving <no-reply@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# Server-only application security / scheduled operations
# Generate unique values per environment when these features are implemented.
# -----------------------------------------------------------------------------
APP_ENCRYPTION_KEY=
CRON_SECRET=
